# ===== Supabase (PostgreSQL qua PgBouncer - port 6543) =====
SUPABASE_HOST=aws-0-ap-southeast-1.pooler.supabase.com
SUPABASE_PORT=6543
SUPABASE_DB=postgres
SUPABASE_USER=postgres.your-project-ref
SUPABASE_PASSWORD=your-database-password

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password

# ===== Initial Admin =====
ADMIN_EMAIL=
# BCrypt hash only. Do not put the plaintext password here.
ADMIN_PASSWORD_HASH=

# ===== JWT =====
JWT_SECRET=change-me-to-a-very-long-secret-key-at-least-64-characters-for-hs512
JWT_ACCESS_EXPIRATION=1800000
JWT_REFRESH_EXPIRATION=2592000000

# ===== Brevo transactional email =====
BREVO_API_KEY=
BREVO_API_URL=https://api.brevo.com
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Tikzy

# ===== Authentication recovery policy (account unlock + password reset) =====
# Initial fallback; Admin can change the persisted value through the admin API.
SECURITY_MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_UNLOCK_OTP_EXPIRATION_MINUTES=10
ACCOUNT_UNLOCK_RESET_TOKEN_EXPIRATION_MINUTES=10
ACCOUNT_UNLOCK_MAX_OTP_ATTEMPTS=5

# ===== Grafana Telegram alerting =====
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ===== Cloudinary =====
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ===== Ticket QR HMAC secret =====
QR_SECRET=change-me-qr-hmac-secret

# ===== Server =====
SERVER_PORT=8080

# ===== Production observability =====
# Must match the existing Docker network on the production VPS.
TIKZY_NETWORK=tikzy_tikzy
GRAFANA_ROOT_URL=https://grafana.example.com
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Pin tested image versions in production instead of using the compose defaults.
GRAFANA_VERSION=
LOKI_VERSION=
MIMIR_VERSION=
TEMPO_VERSION=
ALLOY_VERSION=
NODE_EXPORTER_VERSION=

# ===== OpenTelemetry =====
# Keep disabled until the production Alloy stack is running.
OTEL_SDK_DISABLED=true
OTEL_SERVICE_NAME=tikzy-backend
OTEL_RESOURCE_ATTRIBUTES=service.namespace=tikzy,deployment.environment=production
OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none
OTEL_INSTRUMENTATION_LOGBACK_MDC_ENABLED=true
