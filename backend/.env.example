# ===== Supabase (PostgreSQL qua PgBouncer - port 6543) =====
SUPABASE_HOST=aws-0-ap-southeast-1.pooler.supabase.com
SUPABASE_PORT=6543
SUPABASE_DB=postgres
SUPABASE_USER=postgres.your-project-ref
SUPABASE_PASSWORD=your-database-password

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password

# ===== Initial Admin =====
ADMIN_EMAIL=
# BCrypt hash only. Do not put the plaintext password here.
ADMIN_PASSWORD_HASH=

# ===== JWT =====
JWT_SECRET=change-me-to-a-very-long-secret-key-at-least-64-characters-for-hs512
JWT_ACCESS_EXPIRATION=1800000
JWT_REFRESH_EXPIRATION=2592000000

# ===== Brevo transactional email =====
BREVO_API_KEY=
BREVO_API_URL=https://api.brevo.com
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Tikzy

# ===== Cloudinary =====
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ===== Ticket QR HMAC secret =====
QR_SECRET=change-me-qr-hmac-secret

# ===== Server =====
SERVER_PORT=8080
